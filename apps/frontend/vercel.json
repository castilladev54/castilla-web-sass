{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "services": {
        "backend": {
            "root": "apps/backend",
            "framework": "express",
            "entrypoint": "server.ts"
        },
        "frontend": {
            "root": "apps/frontend",
            "framework": "vite",
            "outputDirectory": "dist"
        }
    },
    "rewrites": [
        {
            "source": "/(.*)",
            "destination": "/index.html"
        },
        {
            "source": "/api/(.*)",
            "destination": {
                "service": "backend"
            }
        },
        {
            "source": "/(.*)",
            "destination": {
                "service": "frontend"
            }
        }
    ]
}